# MongoDB
MONGO_URI=mongodb://localhost:27017

# Firebase Admin SDK (download service account JSON from Firebase Console)
# Option A: path to JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B: inline JSON (single line) — do not commit real credentials
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated admin emails (copy this file to backend/.env — the server reads .env, not .env.example)
FIREBASE_ADMIN_EMAILS=your-admin@gmail.com

# Sola Energy Agent (LangGraph). Never commit a real key.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base URL:
# OPENAI_BASE_URL=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# SOLA_RAG_EMBEDDINGS=auto
