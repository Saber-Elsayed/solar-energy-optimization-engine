# Copy to frontend/.env and restart Expo (npx expo start -c).
#
# Required on a physical phone — especially with "expo start --tunnel" (tunnel only forwards
# Metro/8081, NOT your API on port 8000).
#
# 1. Find your PC IP: ipconfig  →  IPv4 e.g. 192.168.1.12
# 2. Run backend: uvicorn app.server:create_app --factory --host 0.0.0.0 --port 8000 --reload
# 3. Set:
EXPO_PUBLIC_API_URL=http://192.168.1.12:8000

# Optional port if EXPO_PUBLIC_API_URL is not set (Metro LAN host is used automatically in Expo Go)
# EXPO_PUBLIC_API_PORT=8000
