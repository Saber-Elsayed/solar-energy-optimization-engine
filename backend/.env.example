# MongoDB
MONGO_URI=mongodb://localhost:27017

# Firebase Admin SDK (download service account JSON from Firebase Console)
# Option A: path to JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B: inline JSON (single line) — do not commit real credentials
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated admin emails (copy this file to backend/.env — the server reads .env, not .env.example)
FIREBASE_ADMIN_EMAILS=your-admin@gmail.com
